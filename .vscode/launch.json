{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Flask app (port 5001)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "5001" },
      "console": "integratedTerminal"
    },
    {
      "name": "Check setup",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/check_setup.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
